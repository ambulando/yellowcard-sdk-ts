{
  "name": "@ambulando/yellowcard-sdk",
  "version": "1.3.2",
  "description": "TypeScript client for the YellowCard API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:live": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.live.config.js",
    "typecheck": "tsc --noEmit",
    "publish:public": "npm publish --access public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "crypto-js": "^4.2.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
